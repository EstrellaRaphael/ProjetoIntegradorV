generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Tabela criada via script_auth.sql (rodar antes de iniciar o serviço)
model usuario {
  id            String       @id @db.Char(36)
  email         String       @unique @db.VarChar(255)
  senha_hash    String       @db.VarChar(255)
  role          usuario_role
  referencia_id String?      @db.Char(36)
  ativo         Boolean      @default(true)
  created_at    DateTime     @default(now()) @db.Timestamp(0)
  updated_at    DateTime     @default(now()) @updatedAt @db.Timestamp(0)
  aluno         aluno?       @relation(fields: [referencia_id], references: [id])

  @@index([role])
  @@index([ativo])
}

// Modelo do mesmo schema (raphaelestrella) para incluir turma_atual_id no JWT
model aluno {
  id              String       @id @db.Char(36)
  matricula       String       @unique @db.VarChar(30)
  nome_completo   String       @db.VarChar(255)
  data_nascimento DateTime     @db.Date
  email           String       @unique @db.VarChar(255)
  cpf             String       @unique @db.VarChar(14)
  telefone        String?      @db.VarChar(20)
  end_logradouro  String       @db.VarChar(255)
  end_numero      String       @db.VarChar(20)
  end_complemento String?      @db.VarChar(100)
  end_bairro      String       @db.VarChar(100)
  end_cidade      String       @db.VarChar(100)
  end_estado      String       @db.Char(2)
  end_cep         String       @db.VarChar(9)
  turma_atual_id  String?      @db.Char(36)
  status          aluno_status @default(ATIVO)
  created_at      DateTime     @default(now()) @db.Timestamp(0)
  updated_at      DateTime     @default(now()) @updatedAt @db.Timestamp(0)
  usuario         usuario[]
}

enum usuario_role {
  ADMIN
  PROFESSOR
  ALUNO
}

enum aluno_status {
  ATIVO
  INATIVO
  TRANSFERIDO
}
